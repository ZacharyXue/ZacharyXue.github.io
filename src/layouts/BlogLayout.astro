---
import BaseLayout from './BaseLayout.astro';
import '/src/styles/global.css';

export interface Props {
  frontmatter: {
    title: string;
    date: Date;
    tags?: string[];
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;

// 目录只收集 h2/h3（h1 是文章标题，不算）
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article>
    <header class="article-header">
      <h1>{frontmatter.title}</h1>
      <time datetime={frontmatter.date.toISOString().slice(0, 10)}>
        {frontmatter.date.toLocaleDateString('zh-CN')}
      </time>
      {frontmatter.tags?.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    {showToc && (
      <nav class="toc" aria-label="目录">
        <div class="toc-title">📑 目录</div>
        <ul class="toc-list">
          {toc.map(item => (
            <li class={`toc-item toc-lv-${item.depth}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<script is:inline>
  (function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      mermaid.initialize({ startOnLoad: false, theme: 'default' });

      var blocks = document.querySelectorAll('.article-body pre[data-language="mermaid"]');
      if (blocks.length === 0) return;

      for (var i = 0; i < blocks.length; i++) {
        var pre = blocks[i];
        var div = document.createElement('div');
        div.className = 'mermaid-wrapper';
        div.textContent = pre.textContent || '';
        pre.replaceWith(div);
      }

      mermaid.run({ querySelector: '.mermaid-wrapper' });
    };
    document.head.appendChild(s);
  })();
</script>

<script>
  // 滚动监听：高亮当前阅读的章节
  window.addEventListener('scroll', function () {
    var links = document.querySelectorAll('.toc-list a');
    if (links.length === 0) return;
    var ids = Array.from(links).map(function (a) {
      return a.getAttribute('href').slice(1);
    });
    // 找到当前视口最靠上且已滚过的标题
    var current = null;
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el && el.getBoundingClientRect().top <= 80) {
        current = ids[i];
      }
    }
    Array.prototype.forEach.call(links, function (a) {
      var active = a.getAttribute('href').slice(1) === current;
      a.classList.toggle('active', active);
    });
  });
</script>

<style>
  .article-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .article-header time {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .tags { margin-top: 0.8rem; display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
  .tag {
    background: var(--accent-color);
    color: var(--white);
    padding: 0.2em 0.7em;
    border-radius: 12px;
    font-size: 0.8rem;
  }
  .mermaid-wrapper {
    margin: 2rem 0;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid-wrapper svg {
    max-width: 100%;
    height: auto;
  }

  /* ===== 目录样式 ===== */
  .toc {
    max-width: 720px;
    margin: 0 auto 2rem auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-color);
    font-size: 0.92rem;
  }
  .toc-title {
    font-weight: 600;
    margin-bottom: 0.6rem;
    color: var(--primary-color);
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .toc-item a {
    color: var(--text-color);
    text-decoration: none;
    border-bottom: 1px dashed transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .toc-item a:hover {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
  }
  .toc-item a.active {
    color: var(--accent-color);
    font-weight: 600;
  }
  .toc-lv-2 { padding-left: 0; }
  .toc-lv-3 { padding-left: 1.2rem; font-size: 0.86rem; }

  @media (max-width: 768px) {
    article { padding: 1rem; }
  }
</style>