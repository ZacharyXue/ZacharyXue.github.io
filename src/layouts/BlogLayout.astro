---
import BaseLayout from './BaseLayout.astro';
import '/src/styles/global.css';

export interface Props {
  frontmatter: {
    title: string;
    date: Date;
    tags?: string[];
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
  readingMinutes?: number;
  prevNav?: { slug: string; title: string };
  nextNav?: { slug: string; title: string };
}

const { frontmatter, headings = [], readingMinutes = 0, prevNav, nextNav } = Astro.props;

// 目录只收集 h2/h3（h1 是文章标题，不算）
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;
// 长文（≥3 节）额外给一个正文顶部可折叠目录：左侧悬浮抽屉太隐蔽，
// 桌面首屏几乎注意不到，长文阅读需要更明显的入口。
const showInlineToc = toc.length >= 3;

// ===== 邮件讨论：mailto 预填，标题带文章名、正文预填原文链接 =====
const SITE = 'https://zacharyxue.github.io';
const DISCUSS_EMAIL = 'xuezihao2016@outlook.com';
const canonicalUrl = new URL(Astro.url.pathname, SITE).href;
const discussSubject = `讨论：《${frontmatter.title}》`;
const discussBody = `原文：${canonicalUrl}\n\n我的评论：\n`;
const mailtoHref = `mailto:${DISCUSS_EMAIL}?subject=${encodeURIComponent(discussSubject)}&body=${encodeURIComponent(discussBody)}`;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} ogType="article">
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article>
    <header class="article-header">
      <h1>{frontmatter.title}</h1>
      <div class="article-meta">
        <time datetime={frontmatter.date.toISOString().slice(0, 10)}>
          {frontmatter.date.toLocaleDateString('zh-CN')}
        </time>
        {readingMinutes > 0 && (
          <>
            <span class="dot">·</span>
            <span>约 {readingMinutes} 分钟</span>
          </>
        )}
      </div>
      {frontmatter.tags?.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map(tag => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      )}
    </header>
    {showInlineToc && (
      <details class="toc-inline">
        <summary>
          <span class="toc-inline-title">📑 本文目录</span>
          <span class="toc-inline-count">{toc.length} 节</span>
        </summary>
        <ul class="toc-inline-list">
          {toc.map(item => (
            <li class={`toc-inline-item toc-inline-lv-${item.depth}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <div class="article-body">
      <slot />
    </div>

    <div class="discuss">
      <a
        class="discuss-link"
        href={mailtoHref}
        title={`邮件讨论本文 · ${DISCUSS_EMAIL}`}
        aria-label={`邮件讨论：${frontmatter.title}`}
      >
        <span class="discuss-icon" aria-hidden="true">✉</span>
        <span>邮件讨论</span>
      </a>
    </div>
  </article>

  <nav class="post-nav" aria-label="文章导航">
    {prevNav && (
      <a href={`/blog/${prevNav.slug}`} class="nav-prev">
        <span class="nav-label">← 上一篇</span>
        <span class="nav-title">{prevNav.title}</span>
      </a>
    )}
    {nextNav && (
      <a href={`/blog/${nextNav.slug}`} class="nav-next">
        <span class="nav-label">下一篇 →</span>
        <span class="nav-title">{nextNav.title}</span>
      </a>
    )}
  </nav>

  {showToc && (
    <>
      <aside class="toc-sidebar" id="toc-sidebar" aria-label="目录">
        <div class="toc-header">
          <span class="toc-header-title">📑 目录</span>
          <button class="toc-close" id="toc-close" aria-label="收起目录">×</button>
        </div>
        <ul class="toc-list">
          {toc.map(item => (
            <li class={`toc-item toc-lv-${item.depth}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </aside>
      <div class="toc-overlay" id="toc-overlay" hidden></div>
      <button class="toc-toggle" id="toc-toggle" aria-label="展开目录" title="目录">📑</button>
    </>
  )}

  <div class="reading-pref" id="reading-pref">
    <button class="rp-toggle" id="rp-toggle" type="button" aria-expanded="false" aria-label="阅读设置：字号与行距">Aa</button>
    <div class="rp-panel" id="rp-panel" hidden>
      <div class="rp-row">
        <span class="rp-label">字号</span>
        <button type="button" data-font="15">小</button>
        <button type="button" data-font="16">标准</button>
        <button type="button" data-font="18">大</button>
      </div>
      <div class="rp-row">
        <span class="rp-label">行距</span>
        <button type="button" data-lh="1.6">紧</button>
        <button type="button" data-lh="1.8">标准</button>
        <button type="button" data-lh="2.1">松</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      mermaid.initialize({ startOnLoad: false, theme: 'default' });
      var blocks = document.querySelectorAll('.article-body pre[data-language="mermaid"]');
      if (blocks.length === 0) return;
      for (var i = 0; i < blocks.length; i++) {
        var pre = blocks[i];
        var div = document.createElement('div');
        div.className = 'mermaid-wrapper';
        // 只取 <code> 内的代码文本：复制按钮是 pre 的子元素，取 pre.textContent 会把"复制"二字喂给 mermaid 解析器（曾导致 xychart/flowchart 报 Syntax error）
        var codeEl = pre.querySelector('code');
        div.textContent = (codeEl ? codeEl : pre).textContent || '';
        pre.replaceWith(div);
      }
      mermaid.run({ querySelector: '.mermaid-wrapper' });
    };
    document.head.appendChild(s);
  })();
</script>

<script>
  // ===== 左侧目录：展开 / 收起 / 遮罩 / 点击跳转后收起 =====
  const sidebar = document.getElementById('toc-sidebar');
  const overlay = document.getElementById('toc-overlay');
  if (sidebar) {
    const toggle = document.getElementById('toc-toggle');
    const close = document.getElementById('toc-close');
    const open = () => {
      sidebar.classList.add('open');
      if (overlay) overlay.hidden = false;
    };
    const closeToc = () => {
      sidebar.classList.remove('open');
      if (overlay) overlay.hidden = true;
    };
    toggle?.addEventListener('click', open);
    close?.addEventListener('click', closeToc);
    overlay?.addEventListener('click', closeToc);
    // 点击目录链接后收起（移动端体验）
    sidebar.querySelectorAll('.toc-list a').forEach(a => {
      a.addEventListener('click', closeToc);
    });

    // ===== 滚动监听：高亮当前阅读的章节 =====
    const links = sidebar.querySelectorAll('.toc-list a');
    if (links.length) {
      const ids = Array.from(links).map(a => a.getAttribute('href').slice(1));
      window.addEventListener('scroll', function () {
        let current = null;
        for (let i = 0; i < ids.length; i++) {
          const el = document.getElementById(ids[i]);
          if (el && el.getBoundingClientRect().top <= 100) current = ids[i];
        }
        links.forEach(a => {
          a.classList.toggle('active', a.getAttribute('href').slice(1) === current);
        });
      });
    }
  }

  // ===== 阅读进度条 =====
  const progress = document.getElementById('read-progress');
  if (progress) {
    const calc = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const pct = total > 0 ? (window.scrollY / total) * 100 : 0;
      progress.style.width = pct + '%';
    };
    window.addEventListener('scroll', calc, { passive: true });
    window.addEventListener('resize', calc);
    calc();
  }

  // ===== 代码块复制按钮 =====
  const blocks = document.querySelectorAll<HTMLElement>('article pre.astro-code');
  blocks.forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = '复制';
    btn.setAttribute('aria-label', '复制代码');
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      const text = (code ? code.innerText : pre.innerText) || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.textContent = '已复制 ✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '复制';
        btn.classList.remove('copied');
      }, 1800);
    });
    pre.appendChild(btn);
  });

  // ===== 表格包一层横向滚动容器 =====
  // 表格本体不能自己 display:block（窄表右侧会多出一段空白 + 竖线），
  // 滚动与外框交给外层 .table-scroll。
  document.querySelectorAll<HTMLTableElement>('article .article-body table').forEach(table => {
    const parent = table.parentElement;
    if (!parent || parent.classList.contains('table-scroll')) return;
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll';
    parent.insertBefore(wrap, table);
    wrap.appendChild(table);
  });

  // ===== S6 标题锚点：hover 显形，点一下复制「本节链接」=====
  document.querySelectorAll<HTMLElement>('article .article-body :is(h2, h3, h4)').forEach(h => {
    if (!h.id || h.querySelector('.heading-anchor')) return;
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = '#' + h.id;
    a.title = '复制本节链接';
    a.setAttribute('aria-label', '复制本节链接');
    a.textContent = '#';
    a.addEventListener('click', ev => {
      const url = location.origin + location.pathname + '#' + h.id;
      if (!navigator.clipboard?.writeText) return; // 不支持就按普通锚点跳转
      ev.preventDefault();
      navigator.clipboard.writeText(url).then(() => {
        a.textContent = '✓';
        setTimeout(() => { a.textContent = '#'; }, 1200);
      }).catch(() => { location.hash = h.id; });
    });
    h.appendChild(a);
  });

  // ===== S7 代码块横向溢出提示 =====
  document.querySelectorAll<HTMLElement>('article .article-body pre').forEach(pre => {
    // mermaid 块会被替换成图形，不包（否则留下空壳容器）
    if (pre.dataset.language === 'mermaid') return;
    if (pre.parentElement?.classList.contains('code-scroll')) return;
    const wrap = document.createElement('div');
    wrap.className = 'code-scroll';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    // Astro 给每个代码块内联了 white-space:pre-wrap + word-wrap:break-word。
    // 对代码是坏事：换行后的行看起来像新语句、注释被拆断、缩进错乱
    // （手机上尤其明显）→ 改回不换行，交给横向滚动 + 下方提示。
    pre.style.whiteSpace = 'pre';
    pre.style.wordWrap = 'normal';
    pre.style.overflowWrap = 'normal';
    const sync = () => {
      wrap.classList.toggle('is-scrollable', pre.scrollWidth > pre.clientWidth + 2);
    };
    sync();
    window.addEventListener('resize', sync);
    setTimeout(sync, 400); // 字体/布局稳定后再量一次
  });

  // ===== S8 阅读设置：字号 / 行距（存 localStorage，跨页生效）=====
  const rpToggle = document.getElementById('rp-toggle');
  const rpPanel = document.getElementById('rp-panel');
  const RP_KEY = 'reading-pref';
  const rpRead = (): { font?: string; lh?: string } => {
    try { return JSON.parse(localStorage.getItem(RP_KEY) || '{}'); } catch { return {}; }
  };
  const rpApply = (pref: { font?: string; lh?: string }) => {
    const font = pref.font || '16';
    const lh = pref.lh || '1.8';
    document.documentElement.style.fontSize = font + 'px';
    document.documentElement.style.setProperty('--reading-line-height', lh);
    rpPanel?.querySelectorAll<HTMLButtonElement>('[data-font]').forEach(b => {
      b.setAttribute('aria-pressed', String(b.dataset.font === font));
    });
    rpPanel?.querySelectorAll<HTMLButtonElement>('[data-lh]').forEach(b => {
      b.setAttribute('aria-pressed', String(b.dataset.lh === lh));
    });
  };
  let rpPref = rpRead();
  rpApply(rpPref);
  if (rpToggle && rpPanel) {
    const rpClose = () => { rpPanel.hidden = true; rpToggle.setAttribute('aria-expanded', 'false'); };
    rpToggle.addEventListener('click', () => {
      if (rpPanel.hidden) {
        rpPanel.hidden = false;
        rpToggle.setAttribute('aria-expanded', 'true');
      } else {
        rpClose();
      }
    });
    rpPanel.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.dataset.font) rpPref.font = btn.dataset.font;
      if (btn.dataset.lh) rpPref.lh = btn.dataset.lh;
      rpApply(rpPref);
      try { localStorage.setItem(RP_KEY, JSON.stringify(rpPref)); } catch { /* 隐私模式下忽略 */ }
    });
    document.addEventListener('click', e => {
      const t = e.target as Node;
      if (!rpPanel.hidden && !rpPanel.contains(t) && !rpToggle.contains(t)) rpClose();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') rpClose(); });
  }
</script>

<script>
  // ===== 图片懒加载 + 点击放大（lightbox） =====
  const imgs = document.querySelectorAll<HTMLImageElement>('article .article-body img');
  imgs.forEach(img => {
    img.loading = 'lazy';
    img.decoding = 'async';
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      const mask = document.createElement('div');
      mask.className = 'lightbox-mask';
      const big = document.createElement('img');
      big.src = img.src;
      big.alt = img.alt || '';
      mask.appendChild(big);
      document.body.appendChild(mask);
      document.body.style.overflow = 'hidden';
      const close = () => {
        mask.remove();
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKey);
      };
      const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
      mask.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
    });
  });
</script>

<style>
  .article-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .article-header h1 { font-size: 1.9rem; line-height: 1.4; margin-bottom: 0.7rem; }
  .article-meta { display: flex; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .article-meta time, .article-meta span { color: var(--text-muted); font-size: 0.9rem; }
  .article-meta .dot { opacity: 0.5; }
  .tags { margin-top: 0.9rem; display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
  .tag {
    background: color-mix(in srgb, var(--accent-color) 10%, transparent);
    color: var(--accent-color);
    padding: 0.2em 0.9em;
    border-radius: 12px;
    font-size: 0.8rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .tag:hover { background: var(--accent-color); color: #fff; }
  .mermaid-wrapper {
    margin: 2rem 0;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid-wrapper svg {
    max-width: 100%;
    height: auto;
  }
  /* 锚点跳转时不被顶部导航挡住 */
  .article-body :is(h2, h3, h4) { scroll-margin-top: 72px; }

  /* ===== 左侧固定目录（overlay 抽屉式） ===== */
  .toc-sidebar {
    position: fixed;
    top: 60px;
    left: 0;
    bottom: 0;
    width: 260px;
    padding: 1.25rem 1rem 2rem 1.4rem;
    background: var(--bg-color);
    border-right: 1px solid var(--border-color);
    box-shadow: 2px 0 12px rgba(0,0,0,0.08);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    z-index: 40;
  }
  .toc-sidebar.open { transform: translateX(0); }
  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .toc-header-title {
    font-weight: 600;
    color: var(--text-color);
    font-size: 1rem;
  }
  .toc-close {
    background: none;
    border: none;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0 0.2rem;
  }
  .toc-close:hover { color: var(--accent-color); }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .toc-item a {
    display: block;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    padding: 0.2rem 0.4rem;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .toc-item a:hover { color: var(--accent-color); }
  .toc-item a.active {
    color: var(--accent-color);
    border-left-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 8%, transparent);
    font-weight: 600;
  }
  .toc-lv-2 { margin-top: 0.1rem; }
  .toc-lv-3 a { padding-left: 1.2rem; font-size: 0.84rem; }

  /* 遮罩（移动端点空白收起） */
  .toc-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 35;
  }

  /* 展开按钮（悬浮左侧中部） */
  .toc-toggle {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border-color);
    border-left: none;
    border-radius: 0 8px 8px 0;
    background: var(--bg-color);
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 1px 1px 6px rgba(0,0,0,0.1);
    transition: color 0.15s ease;
  }
  .toc-toggle:hover { color: var(--accent-color); }

  @media (max-width: 768px) {
    article { padding: 1rem; }
    .article-header h1 { font-size: 1.6rem; }
  }
  /* ===== 正文顶部可折叠目录（长文入口） ===== */
  .toc-inline {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--card-bg);
    margin-bottom: 2rem;
    padding: 0.2rem 1rem;
  }
  .toc-inline > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    cursor: pointer;
    padding: 0.7rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-color);
    list-style: none;
  }
  .toc-inline > summary::-webkit-details-marker { display: none; }
  .toc-inline > summary::after {
    content: '▾';
    color: var(--text-muted);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .toc-inline[open] > summary::after { transform: rotate(180deg); }
  .toc-inline-count {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  .toc-inline-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  /* 长目录（如 29 节）展开后会占满整屏、把正文推下去，这里限高内部滚动 */
  .toc-inline[open] .toc-inline-list {
    max-height: min(60vh, 460px);
    overflow-y: auto;
  }
  .toc-inline-item a {
    display: block;
    padding: 0.2rem 0.2rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .toc-inline-item a:hover { color: var(--accent-color); }
  .toc-inline-lv-3 a { padding-left: 1.3rem; font-size: 0.85rem; }

  /* ===== 邮件讨论：轻描边小胶囊，静息可见、hover 点亮 ===== */
  .discuss {
    margin-top: 2.5rem;
    text-align: center;
  }
  .discuss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border: 1px solid color-mix(in srgb, var(--text-muted) 30%, var(--border-color));
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .discuss-link:hover {
    color: var(--accent-color);
    border-color: color-mix(in srgb, var(--accent-color) 40%, transparent);
    background: color-mix(in srgb, var(--accent-color) 8%, transparent);
  }
  .discuss-icon { font-size: 0.95rem; line-height: 1; }
  .discuss-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent-color) 60%, transparent);
    outline-offset: 2px;
  }
  /* 收一收「上一篇/下一篇」的上边距，避免讨论按钮悬在两段大留白中间 */
  .post-nav { margin-top: 2rem; }

  /* ===== 阅读设置（字号 / 行距）===== */
  .reading-pref {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 45;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
