---
import BaseLayout from './BaseLayout.astro';
import '/src/styles/global.css';

export interface Props {
  frontmatter: {
    title: string;
    date: Date;
    tags?: string[];
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;

// 目录只收集 h2/h3（h1 是文章标题，不算）
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article>
    <header class="article-header">
      <h1>{frontmatter.title}</h1>
      <time datetime={frontmatter.date.toISOString().slice(0, 10)}>
        {frontmatter.date.toLocaleDateString('zh-CN')}
      </time>
      {frontmatter.tags?.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>

  {showToc && (
    <>
      <aside class="toc-sidebar" id="toc-sidebar" aria-label="目录">
        <div class="toc-header">
          <span class="toc-header-title">📑 目录</span>
          <button class="toc-close" id="toc-close" aria-label="收起目录">×</button>
        </div>
        <ul class="toc-list">
          {toc.map(item => (
            <li class={`toc-item toc-lv-${item.depth}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </aside>
      <div class="toc-overlay" id="toc-overlay" hidden></div>
      <button class="toc-toggle" id="toc-toggle" aria-label="展开目录" title="目录">📑</button>
    </>
  )}
</BaseLayout>

<script is:inline>
  (function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      mermaid.initialize({ startOnLoad: false, theme: 'default' });
      var blocks = document.querySelectorAll('.article-body pre[data-language="mermaid"]');
      if (blocks.length === 0) return;
      for (var i = 0; i < blocks.length; i++) {
        var pre = blocks[i];
        var div = document.createElement('div');
        div.className = 'mermaid-wrapper';
        div.textContent = pre.textContent || '';
        pre.replaceWith(div);
      }
      mermaid.run({ querySelector: '.mermaid-wrapper' });
    };
    document.head.appendChild(s);
  })();
</script>

<script>
  // ===== 左侧目录：展开 / 收起 / 遮罩 / 点击跳转后收起 =====
  const sidebar = document.getElementById('toc-sidebar');
  const overlay = document.getElementById('toc-overlay');
  if (sidebar) {
    const toggle = document.getElementById('toc-toggle');
    const close = document.getElementById('toc-close');
    const open = () => {
      sidebar.classList.add('open');
      if (overlay) overlay.hidden = false;
    };
    const closeToc = () => {
      sidebar.classList.remove('open');
      if (overlay) overlay.hidden = true;
    };
    toggle?.addEventListener('click', open);
    close?.addEventListener('click', closeToc);
    overlay?.addEventListener('click', closeToc);
    // 点击目录链接后收起（移动端体验）
    sidebar.querySelectorAll('.toc-list a').forEach(a => {
      a.addEventListener('click', closeToc);
    });

    // ===== 滚动监听：高亮当前阅读的章节 =====
    const links = sidebar.querySelectorAll('.toc-list a');
    if (links.length) {
      const ids = Array.from(links).map(a => a.getAttribute('href').slice(1));
      window.addEventListener('scroll', function () {
        let current = null;
        for (let i = 0; i < ids.length; i++) {
          const el = document.getElementById(ids[i]);
          if (el && el.getBoundingClientRect().top <= 100) current = ids[i];
        }
        links.forEach(a => {
          a.classList.toggle('active', a.getAttribute('href').slice(1) === current);
        });
      });
    }
  }
</script>

<style>
  .article-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .article-header time {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .tags { margin-top: 0.8rem; display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
  .tag {
    background: var(--accent-color);
    color: var(--white);
    padding: 0.2em 0.7em;
    border-radius: 12px;
    font-size: 0.8rem;
  }
  .mermaid-wrapper {
    margin: 2rem 0;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid-wrapper svg {
    max-width: 100%;
    height: auto;
  }
  /* 锚点跳转时不被顶部导航挡住 */
  .article-body :is(h2, h3, h4) { scroll-margin-top: 72px; }

  /* ===== 左侧固定目录（overlay 抽屉式） ===== */
  .toc-sidebar {
    position: fixed;
    top: 60px;
    left: 0;
    bottom: 0;
    width: 260px;
    padding: 1.25rem 1rem 2rem 1.4rem;
    background: var(--bg-color);
    border-right: 1px solid var(--border-color);
    box-shadow: 2px 0 12px rgba(0,0,0,0.08);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    z-index: 40;
  }
  .toc-sidebar.open { transform: translateX(0); }
  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .toc-header-title {
    font-weight: 600;
    color: var(--primary-color);
    font-size: 1rem;
  }
  .toc-close {
    background: none;
    border: none;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0 0.2rem;
  }
  .toc-close:hover { color: var(--accent-color); }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .toc-item a {
    display: block;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    padding: 0.2rem 0.4rem;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .toc-item a:hover { color: var(--accent-color); }
  .toc-item a.active {
    color: var(--accent-color);
    border-left-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 8%, transparent);
    font-weight: 600;
  }
  .toc-lv-2 { margin-top: 0.1rem; }
  .toc-lv-3 a { padding-left: 1.2rem; font-size: 0.84rem; }

  /* 遮罩（移动端点空白收起） */
  .toc-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 35;
  }

  /* 展开按钮（悬浮左侧中部） */
  .toc-toggle {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border-color);
    border-left: none;
    border-radius: 0 8px 8px 0;
    background: var(--bg-color);
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 1px 1px 6px rgba(0,0,0,0.1);
    transition: color 0.15s ease;
  }
  .toc-toggle:hover { color: var(--accent-color); }

  @media (max-width: 768px) {
    article { padding: 1rem; }
  }
</style>