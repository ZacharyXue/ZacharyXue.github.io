---
/**
 * WikiLayout — 知识点详情页布局
 *
 * 与 BlogLayout 的区别：
 *   - 没有「邮件讨论」卡片（wiki 页是内部知识卡的公开视图，不引导读者来信）
 *   - 有面包屑 + 可信度标记 + 同域上下篇导航
 *   - 复用 global.css 的 article 排版（等价于博客正文观感）
 */
import BaseLayout from './BaseLayout.astro';
import '/src/styles/global.css';

export interface Props {
  title: string;
  domain: string;
  domainLabel: string;
  created?: string;
  updated?: string;
  tags?: string[];
  confidence?: string;
  prevNav?: { href: string; title: string };
  nextNav?: { href: string; title: string };
}

const {
  title, domain, domainLabel, created = '', updated = '',
  tags = [], confidence = '', prevNav, nextNav,
} = Astro.props;

const CONFIDENCE_LABEL: Record<string, string> = {
  high: '证据充分',
  medium: '部分待验',
  low: '证据不足',
};
const confLabel = CONFIDENCE_LABEL[confidence] || '';
---

<BaseLayout title={title} description={`${domainLabel} · 知识点`} ogType="article">
  <article class="wiki-article">
    <nav class="crumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span class="sep">/</span>
      <a href="/wiki">知识点</a>
      <span class="sep">/</span>
      <a href={`/wiki#${domain}`}>{domainLabel}</a>
    </nav>

    <header class="wiki-header">
      <h1>{title}</h1>
      <div class="wiki-meta">
        <span class="badge">{domainLabel}</span>
        {confLabel && <span class="conf" data-level={confidence}>● {confLabel}</span>}
        {updated && <span class="date">更新于 {updated}</span>}
      </div>
      {tags.length > 0 && (
        <div class="wiki-tags">
          {tags.map(t => <a class="tag" href={`/wiki?tag=${encodeURIComponent(t)}`}>{t}</a>)}
        </div>
      )}
    </header>

    <div class="article-body">
      <slot />
    </div>

    {(prevNav || nextNav) && (
      <nav class="wiki-pager" aria-label="同域知识点导航">
        {prevNav ? (
          <a class="pager-item prev" href={prevNav.href}>
            <span class="pager-label">← 上一个知识点</span>
            <span class="pager-title">{prevNav.title}</span>
          </a>
        ) : <span />}
        {nextNav && (
          <a class="pager-item next" href={nextNav.href}>
            <span class="pager-label">下一个知识点 →</span>
            <span class="pager-title">{nextNav.title}</span>
          </a>
        )}
      </nav>
    )}

    <p class="back-link"><a href="/wiki">← 返回知识点索引</a></p>
  </article>
</BaseLayout>

<style>
  .wiki-article { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1rem 3rem; }

  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-color); }
  .crumbs .sep { margin: 0 0.45rem; opacity: 0.5; }

  .wiki-header { margin-bottom: 2rem; }
  .wiki-header h1 { font-size: 2rem; color: var(--text-color); margin-bottom: 0.6rem; line-height: 1.3; }
  .wiki-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--text-muted); }
  .badge {
    padding: 0.15em 0.7em; border-radius: 999px; font-size: 0.78rem;
    background: color-mix(in srgb, var(--accent-color) 12%, transparent);
    color: var(--accent-color);
  }
  .conf { font-size: 0.78rem; }
  .conf[data-level="high"] { color: #2e9e5b; }
  .conf[data-level="medium"] { color: #d09a2a; }
  .conf[data-level="low"] { color: #c85a5a; }
  .wiki-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.7rem; }
  .wiki-tags .tag {
    font-size: 0.75rem; padding: 0.12em 0.6em; border-radius: 10px;
    background: color-mix(in srgb, var(--accent-color) 8%, transparent);
    color: var(--accent-color); text-decoration: none;
  }
  .wiki-tags .tag:hover { background: var(--accent-color); color: #fff; }

  /* 第一个 h2 固定是「一句话本质」，把它下面那段做成高亮卡 */
  .article-body :global(article h2:first-of-type + p),
  .article-body :global(h2:first-of-type + p) {
    border-left: 3px solid var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 6%, transparent);
    padding: 0.85rem 1rem;
    border-radius: 0 8px 8px 0;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .wiki-pager { display: flex; gap: 1rem; margin-top: 3rem; }
  .pager-item {
    flex: 1; display: flex; flex-direction: column; gap: 0.3rem;
    padding: 0.9rem 1.1rem; border: 1px solid var(--border-color);
    border-radius: 10px; background: var(--card-bg); text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pager-item:hover { border-color: var(--accent-color); transform: translateY(-2px); }
  .pager-item.next { text-align: right; }
  .pager-label { font-size: 0.75rem; color: var(--text-muted); }
  .pager-title { font-size: 0.92rem; color: var(--text-color); }

  .back-link { margin-top: 2rem; font-size: 0.9rem; }
  .back-link a { color: var(--text-muted); text-decoration: none; }
  .back-link a:hover { color: var(--accent-color); }

  @media (max-width: 768px) {
    .wiki-article { padding: 1.5rem 1rem 2rem; }
    .wiki-header h1 { font-size: 1.5rem; }
    .wiki-pager { flex-direction: column; }
  }
</style>
