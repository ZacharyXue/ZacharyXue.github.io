---
import BaseLayout from '../layouts/BaseLayout.astro';
import '/src/styles/global.css';
---

<BaseLayout title="页面不存在">
  <main class="notfound">
    <p class="code">404</p>
    <h1>页面走丢了</h1>
    <p class="desc">你访问的页面不存在，可能被移动或删除。</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">回到首页</a>
      <a class="btn btn-ghost" href="/blog">浏览全部文章</a>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6rem 1rem;
    text-align: center;
  }
  .code {
    font-size: 4rem;
    font-weight: 700;
    color: var(--accent-color);
    opacity: 0.8;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }
  .notfound h1 { font-size: 1.6rem; color: var(--text-color); margin-bottom: 0.8rem; }
  .desc { color: var(--text-muted); margin-bottom: 2rem; }
  .actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 0.55rem 1.4rem;
    border-radius: 24px;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: var(--accent-color); color: #fff; }
  .btn-ghost { border: 1px solid var(--border-color); color: var(--text-color); }
  .btn-ghost:hover { border-color: var(--accent-color); color: var(--accent-color); }
  @media (max-width: 768px) { .notfound { padding: 4rem 1rem; } }
</style>