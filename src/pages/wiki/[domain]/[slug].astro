---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('wiki');
  return pages.map(page => {
    // Astro legacy content collection id：`<domain>/<slug>`
    const [domain, slug] = page.id.replace(/\.md$/, '').split('/');
    return { params: { domain, slug }, props: { page, domain, slug } };
  });
}

const { page, domain, slug } = Astro.props;
const { Content } = await page.render();

// 同域内按 title 排序做上一页/下一页（域内顺序稳定，便于顺序浏览）
const siblings = (await getCollection('wiki'))
  .filter(p => p.data.domain === domain && p.id !== page.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));

const idx = siblings.findIndex(p => p.data.title.localeCompare(page.data.title, 'zh-CN') > 0);
const next = siblings.slice(idx).sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))[0];
const prev = [...siblings]
  .filter(p => p.data.title.localeCompare(page.data.title, 'zh-CN') < 0)
  .sort((a, b) => b.data.title.localeCompare(a.data.title, 'zh-CN'))[0];

const toNav = (p?: (typeof siblings)[number]) =>
  p ? { href: `/wiki/${p.data.domain}/${p.id.replace(/\.md$/, '').split('/')[1]}`, title: p.data.title } : undefined;
---

<WikiLayout
  title={page.data.title}
  domain={domain}
  domainLabel={page.data.domainLabel}
  created={page.data.created}
  updated={page.data.updated}
  tags={page.data.tags}
  confidence={page.data.confidence}
  prevNav={toNav(prev)}
  nextNav={toNav(next)}
>
  <Content />
</WikiLayout>
