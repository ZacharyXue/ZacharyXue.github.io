---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '/src/styles/global.css';

const projects = (await getCollection('projects'))
  .map(project => ({
    project,
    slug: project.id.replace(/\.md$/, ''),
  }));
---

<BaseLayout title="项目">
  <main class="project-list">
    <h1>项目</h1>
    {projects.length === 0 ? (
      <p class="empty">还没有项目。</p>
    ) : (
      <div class="project-grid">
        {projects.map(({ project, slug }) => (
          <div class="project-card">
            <a href={`/projects/${slug}`}>
              <h2>{project.data.title}</h2>
            </a>
            <div class="card-tags">
              {project.data.tags?.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {project.data.status && (
              <span class={`card-status card-status-${project.data.status}`}>
                {project.data.status === 'active' ? '● 活跃' : '● 归档'}
              </span>
            )}
          </div>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .project-list {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .project-list h1 {
    font-size: 2rem;
    color: var(--text-color);
    margin-bottom: 2rem;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    background: var(--white);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .project-card a { text-decoration: none; }
  .project-card h2 {
    font-size: 1.2rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }
  .project-card a:hover h2 { color: var(--accent-color); }
  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .tag {
    background: var(--accent-color);
    color: var(--white);
    padding: 0.15em 0.6em;
    border-radius: 10px;
    font-size: 0.75rem;
  }
  .card-status {
    font-size: 0.8rem;
  }
  .card-status-active { color: #27ae60; }
  .card-status-archived { color: #95a5a6; }
  .empty { color: var(--text-muted); }
  @media (max-width: 768px) {
    .project-list { padding: 2rem 1rem; }
  }
</style>
