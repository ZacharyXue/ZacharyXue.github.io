---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '/src/styles/global.css';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft && !p.data.hide_from_home)
  .sort((a, b) => {
    // pinned posts first, then by date descending
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .map(post => ({
    post,
    slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, ''),
  }));

// 热门标签：首页公开文章中出现 >= 2 次的标签, 按频次降序取前 8
const tagCounts = new Map<string, number>();
posts.forEach(p => (p.post.data.tags || []).forEach(t => tagCounts.set(t, (tagCounts.get(t) || 0) + 1)));
const hotTags = [...tagCounts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([t]) => t)
  .slice(0, 8);
---

<BaseLayout title="首页">
  <div class="page">
    <section class="hero" data-pagefind-ignore>
      <h1>你好，我是 Zachary Xue 👋</h1>
      <p class="hero-sub">
        从土木到机械、再到代码的跨界程序员。<br />
        写代码 · 读源码 · 做投资 · 爱骑行，把学到的东西认真记下来。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/blog">阅读全部文章 →</a>
        <a class="btn btn-ghost" href="/about">关于我</a>
      </div>
      {hotTags.length > 0 && (
        <div class="hot-tags">
          <span class="hot-label">热门</span>
          {hotTags.map(tag => (
            <a class="hot-tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
          ))}
        </div>
      )}
    </section>

    <section class="post-list">
      <div class="list-head">
        <h2>最新文章</h2>
        <a class="list-more" href="/blog">查看全部 ›</a>
      </div>
      {posts.length === 0 ? (
        <p class="empty">还没有文章。</p>
      ) : (
        <ul class="posts">
          {posts.map(({ post, slug }) => (
            <li class="post-item">
              <a href={`/blog/${slug}`} class="post-link">
                <h3>{post.data.pinned && '📌 '}{post.data.title}</h3>
                <p class="post-desc">{post.data.description}</p>
                <div class="post-foot">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {post.data.date.toLocaleDateString('zh-CN')}
                  </time>
                  {post.data.tags?.length > 0 && (
                    <span class="post-tags">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="tag-chip">{tag}</span>
                      ))}
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .page { max-width: var(--max-width); margin: 0 auto; padding: 0 1rem 3rem; }

  /* ===== Hero ===== */
  .hero {
    padding: 3.5rem 0 2.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
  }
  .hero h1 {
    font-size: 2.2rem;
    color: var(--text-color);
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 2;
    margin-bottom: 1.5rem;
  }
  .hero-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .btn {
    display: inline-block;
    padding: 0.55rem 1.4rem;
    border-radius: 24px;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary {
    background: var(--accent-color);
    color: #fff;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--accent-color) 40%, transparent);
  }
  .btn-primary:hover { box-shadow: 0 4px 14px color-mix(in srgb, var(--accent-color) 55%, transparent); }
  .btn-ghost {
    border: 1px solid var(--border-color);
    color: var(--text-color);
  }
  .btn-ghost:hover { border-color: var(--accent-color); color: var(--accent-color); }

  .hot-tags { display: flex; gap: 0.4rem 0.6rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .hot-label { font-size: 0.8rem; color: var(--text-muted); margin-right: 0.2rem; }
  .hot-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    transition: all 0.15s ease;
  }
  .hot-tag:hover { border-color: var(--accent-color); color: var(--accent-color); }

  /* ===== 文章卡片 ===== */
  .list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .list-head h2 { font-size: 1.4rem; color: var(--text-color); }
  .list-more { font-size: 0.9rem; color: var(--accent-color); text-decoration: none; }
  .list-more:hover { text-decoration: underline; }

  .posts { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .post-item { margin: 0; }
  .post-link {
    display: block;
    text-decoration: none;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.3rem 1.5rem;
    box-shadow: var(--card-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .post-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--accent-color);
  }
  .post-link h3 {
    font-size: 1.2rem;
    color: var(--text-color);
    margin-bottom: 0.4rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .post-link:hover h3 { color: var(--accent-color); }
  .post-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 0.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .post-foot time { color: var(--text-muted); font-size: 0.82rem; }
  .post-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tag-chip {
    font-size: 0.72rem;
    color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 10%, transparent);
    padding: 0.1em 0.6em;
    border-radius: 10px;
  }
  .empty { color: var(--text-muted); text-align: center; padding: 3rem 0; }

  @media (max-width: 768px) {
    .page { padding: 0 1rem 2rem; }
    .hero { padding: 2.5rem 0 2rem; }
    .hero h1 { font-size: 1.7rem; }
    .post-link { padding: 1.1rem 1.2rem; }
  }
</style>