---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '/src/styles/global.css';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(post => ({
    post,
    slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, ''),
  }));
---

<BaseLayout title="首页">
  <div class="post-list">
    {posts.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      <ul class="posts">
        {posts.map(({ post, slug }) => (
          <li class="post-item">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {post.data.date.toLocaleDateString('zh-CN')}
            </time>
            <a href={`/blog/${slug}`}>
              <h2>{post.data.title}</h2>
            </a>
            {post.data.description && (
              <p>{post.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .post-list { max-width: var(--max-width); margin: 0 auto; padding: 3rem 1rem; }
  .posts { list-style: none; padding: 0; }
  .post-item { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); }
  .post-item a { text-decoration: none; }
  .post-item h2 { font-size: 1.3rem; color: var(--text-color); margin-bottom: 0.3rem; }
  .post-item a:hover h2 { color: var(--accent-color); }
  .post-item time { color: var(--text-muted); font-size: 0.85rem; display: block; margin-bottom: 0.3rem; }
  .post-item p { color: var(--text-muted); margin-top: 0.4rem; font-size: 0.95rem; }
  .empty { color: var(--text-muted); text-align: center; padding: 3rem 0; }
  @media (max-width: 768px) { .post-list { padding: 2rem 1rem; } }
</style>
