---
import { getCollection } from 'astro:content';
import BlogLayout from '/src/layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// 全部非草稿文章按时间排序，用于上一篇 / 下一篇导航
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(p => ({
    post: p,
    slug: p.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, ''),
  }));
const idx = allPosts.findIndex(p => p.post.id === post.id);
const prevNav = idx > 0 && idx < allPosts.length
  ? { slug: allPosts[idx - 1].slug, title: allPosts[idx - 1].post.data.title }
  : undefined;
const nextNav = idx >= 0 && idx < allPosts.length - 1
  ? { slug: allPosts[idx + 1].slug, title: allPosts[idx + 1].post.data.title }
  : undefined;

// 阅读时长估算：按 body 字符数，中文约 400 字/分钟，技术文章取 500
const readingMinutes = Math.max(1, Math.round((post.body || '').length / 500));
---

<BlogLayout frontmatter={post.data} headings={headings} readingMinutes={readingMinutes} prevNav={prevNav} nextNav={nextNav}>
  <Content />
</BlogLayout>