---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '/src/styles/global.css';

const docs = (await getCollection('docs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(doc => ({
    doc,
    slug: doc.id.replace(/\.md$/, ''),
  }));
---

<BaseLayout title="文档">
  <main class="doc-list">
    <h1>文档</h1>
    {docs.length === 0 ? (
      <p class="empty">还没有文档。</p>
    ) : (
      <ul class="docs">
        {docs.map(({ doc, slug }) => (
          <li class="doc-item">
            <a href={`/docs/${slug}`}>
              <h2>{doc.data.title}</h2>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>

<style>
  .doc-list {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .doc-list h1 {
    font-size: 2rem;
    color: var(--text-color);
    margin-bottom: 2rem;
  }
  .docs { list-style: none; padding: 0; }
  .doc-item {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }
  .doc-item a { text-decoration: none; }
  .doc-item h2 { font-size: 1.2rem; color: var(--text-color); }
  .doc-item a:hover h2 { color: var(--accent-color); }
  .empty { color: var(--text-muted); }
  @media (max-width: 768px) {
    .doc-list { padding: 2rem 1rem; }
  }
</style>
